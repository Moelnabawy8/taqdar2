DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ===== Force HTTPS (redirect all HTTP traffic to HTTPS) =====
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ===== SEO bot rewrite — must run FIRST =====
    # Bots get a single PHP entry point that internally fetches /api/seo/<route>.
    # Every public crawlable URL maps via /seo-router.php?path=<original>.
    # Real users skip this entire block and fall through to the React SPA.
    RewriteCond %{HTTP_USER_AGENT} (Googlebot|Google-InspectionTool|GoogleOther|Google-Extended|Bingbot|DuckDuckBot|YandexBot|Slurp|Baiduspider|Sogou|Exabot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Applebot|PetalBot|Bytespider|Amazonbot|SemrushBot|AhrefsBot|MJ12bot|GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai|CCBot|PerplexityBot|Lighthouse|Chrome-Lighthouse) [NC]
    RewriteCond %{REQUEST_URI} ^/(courses(/[a-z0-9_\-]+)?|instructors(/[a-z0-9_\-]+)?|about-us|become-instructor|contact-us|blogs?(/[a-z0-9_\-]+)?|privacy-policy|terms|terms-and-conditions|refund-policy|cookie-policy|faq)?/?$ [NC]
    RewriteRule ^(.*)$ /seo-router.php?path=$1 [L,QSA]

    # /sitemap.xml → fresh canonical sitemap from Sitemap_seo controller
    RewriteRule ^sitemap\.xml$ /api/index.php/sitemap_seo [L]

    # ===== Standard rules =====
    RewriteRule ^_app/ - [L]
    RewriteRule ^login/google_callback /api/login/google_callback [L,QSA]
    RewriteRule ^api/ - [L]

    # Frontend now calls /api/api_<module>/<endpoint> directly (no rewrite needed —
    # the subdirectory's own .htaccess dispatches to CodeIgniter's index.php).
    # Old /api_<module>/* URLs are 307-redirected for backward compatibility
    # with bookmarks / external callers; new code should use /api/api_<module>.
    RewriteRule ^api_courses/(.*)$ /api/api_courses/$1 [L,QSA,R=307]
    RewriteRule ^api_frontend/(.*)$ /api/api_frontend/$1 [L,QSA,R=307]
    RewriteRule ^api_payment/(.*)$ /api/api_payment/$1 [L,QSA,R=307]
    RewriteRule ^api_notifications/(.*)$ /api/api_notifications/$1 [L,QSA,R=307]
    RewriteRule ^api_messages/(.*)$ /api/api_messages/$1 [L,QSA,R=307]
    RewriteRule ^api_admin/(.*)$ /api/api_admin/$1 [L,QSA,R=307]
    RewriteRule ^api_reports/(.*)$ /api/api_reports/$1 [L,QSA,R=307]
    RewriteRule ^api_webhooks/(.*)$ /api/api_webhooks/$1 [L,QSA,R=307]

    RewriteRule ^uploads/(.*)$ /api/uploads/$1 [L]
    RewriteRule ^assets/(.*)$ /api/assets/$1 [L]

    # Clean image-proxy URL: /img/uploads/<path><ext>.jpg → img.php?src=uploads/<path><ext>
    # Ends in .jpg with no query string so strict crawlers (WhatsApp) accept og:image.
    RewriteRule ^img/(uploads/.+)\.jpg$ /img.php?src=$1 [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ /index.html [L]
</IfModule>

# ====================================
# SECURITY HEADERS
# ====================================

<IfModule mod_headers.c>
    Header unset Server
    Header unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: force HTTPS for 1 year (L-01)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Permissions-Policy: restrict browser features (L-01)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self)"
</IfModule>

# ====================================
# GZIP / BROTLI COMPRESSION
# ====================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ====================================
# BROWSER CACHING
# ====================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|js|css|mp4|webm|mp3)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

FileETag None

<IfModule mod_mime.c>
    AddType application/javascript js
    AddType application/json json
    AddType font/woff woff
    AddType font/woff2 woff2
    AddType image/webp webp
    AddType image/svg+xml svg
    AddType video/mp4 mp4
    AddType video/webm webm
</IfModule>

# ====================================
# SECURITY: Block Sensitive Files (C-01, M-05)
# ====================================

# Block ALL sensitive file types from public access
<FilesMatch "\.(bak|bak\-[a-z0-9_\-]+|config|sql|log|sh|gz|tgz|tar|zip|env|map|postman_collection\.json|DS_Store|md|docx|xlsx|pdf|txt|py|before\-[a-z0-9_\-]+)$">
    Require all denied
</FilesMatch>

# Block .htpasswd and .htaccess direct access
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# Block direct access to api/.git directory
<IfModule mod_rewrite.c>
    RewriteRule ^api/\.git(/.*)?$ - [F,L]
</IfModule>

# Block xmlrpc.php attacks
<Files xmlrpc.php>
    Order Deny,Allow
    Deny from all
</Files>
